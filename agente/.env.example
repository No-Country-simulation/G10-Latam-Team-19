# Entorno activo: "dev" usa Cohere/Groq, "prod" usa Gemini
LLM_ENV=dev

# Solo si LLM_ENV=dev. Elegir uno: "groq" o "cohere"
LLM_DEV_PROVIDER=groq

# API keys (completar cada quien con la suya, NO subir este archivo con
# valores reales al repo, copiar como .env y poner valores ahí)
GROQ_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# Descomentar y modificar si se quiere probar el flujo con otros modelos.
#GROQ_MODEL="qwen/qwen3.8-27b"
#COHERE_MODEL="command-a-plus-05-2026"
#GEMINI_MODEL="gemini-3.5-flash-lite"