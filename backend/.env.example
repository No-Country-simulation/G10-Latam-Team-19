ENV=development
STORAGE_PROVIDER=  # r2 | oci (cambiar a 'oci' para la demo oficial)
AGENTE_DIR=../agente

# --- OCI Object Storage (Always Free) ---
OCI_BUCKET=mediflow-documentos-clinicos
OCI_NAMESPACE=axcqfz4mzit6
OCI_REGION=sa-santiago-1

# Credenciales de API Key OCI (100% gestionadas en .env)
OCI_USER=
OCI_FINGERPRINT=
OCI_TENANCY=
OCI_KEY_FILE=./oci_api_key.pem

# --- Cloudflare R2 (Alternativa / Fallback de Object Storage S3-compatible) ---
R2_BUCKET_NAME=mediflow-documentos-clinicos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_REGION_NAME=auto
